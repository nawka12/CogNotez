{
  "name": "cognotez-v5",
  "version": "5.0.0-alpha.1",
  "private": true,
  "description": "CogNotez v5",
  "author": "Kayfa Haarukku",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "lint": "eslint .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@lezer/highlight": "^1.2.5",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^26.6.5",
    "dompurify": "^3.4.17",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "marked": "^18.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.4"
  },
  "build": {
    "appId": "com.kayfahaarukku.cognotez",
    "productName": "CogNotez",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": "universal"
        },
        {
          "target": "zip",
          "arch": "universal"
        }
      ],
      "category": "public.app-category.productivity"
    },
    "artifactName": "CogNotez-${version}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "nawka12",
      "repo": "CogNotez",
      "releaseType": "draft"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
